# ============================================
# SaaS Generator - Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# Flask
# OBLIGATOIRE en production (l'app refuse de demarrer avec la valeur par defaut)
# Generation : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=false

# Encryption key for API keys at rest (auto-derived from SECRET_KEY if not set -
# fortement recommande de la definir pour pouvoir faire tourner les secrets independamment)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Cookies de session servis uniquement en HTTPS (production).
# Mettre a false uniquement pour un deploiement HTTP local sans TLS.
SESSION_COOKIE_SECURE=true

# Database (default: SQLite in project root)
DATABASE_URL=sqlite:///saas_generator.db

# Server binding
HOST=127.0.0.1
PORT=5000

# NOTE : les cles API des providers LLM (Z.AI, OpenRouter, Alibaba, OpenCode Go)
# se configurent par utilisateur dans l'interface (page d'accueil > Configuration),
# pas via des variables d'environnement.
