# ============================================
# SaaS Generator - Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=false

# Encryption key for API keys at rest (auto-derived from SECRET_KEY if not set)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database (default: SQLite in project root)
DATABASE_URL=sqlite:///saas_generator.db

# Server binding
HOST=127.0.0.1
PORT=5000

# LLM Provider API Keys (optional - can also be configured per-user in UI)
ZAI_API_KEY=
OPENROUTER_API_KEY=
ALIBABA_API_KEY=
